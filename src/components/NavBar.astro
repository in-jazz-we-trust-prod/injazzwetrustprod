---
import logo from "../assets/In-Jazz-We-Trust-Prod-Logo.png";
import { Image } from 'astro:assets';
import Socials from '../components/Socials.astro';

import { getMenu } from '../config/menu';

const menuItems = await getMenu();

// Astro.url.pathname contient nativement le trailing slash si l'option est activée.
// On s'assure qu'il se termine par un slash pour la comparaison.
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const isHome = Astro.url.pathname === '/';
const TitleElement = isHome ? 'h1' : 'div';
---

<div id="navbar-sentinel" class="absolute top-0 h-px w-full pointer-events-none"></div>
<header id="navbar" role="banner" class="sticky h-[65px] top-0 navbar transition-shadow ease-in duration-500 z-1000 bg-base-100 px-8" data-theme="light">
        <div class="navbar-start max-md:grow">
                <a href="/" class="hover:text-primary" role="button">
			<TitleElement class="text-lg font-serif">In Jazz We Trust Prod.</TitleElement>
                </a>
        </div>
        
        {/* MENU DESKTOP */}
        <div role="navigation" class="navbar-center hidden lg:flex">
                <ul class="menu menu-horizontal px-1">
                        {menuItems.map((item) => {
                                if (item.items) {
                                        return (
                                                <li class="flex flex-row items-center">
                                                        <div class="dropdown dropdown-center">
                                                                <div tabIndex={0} role="button" class="hover:text-accent focus:text-accent uppercase">
                                                                        {item.name}
                                                                        <svg class="mt-px size-2 fill-current opacity-60 inline-block" xmlns="http://w3.org" viewBox="0 0 2048 2048"><path d="M1799 349l242 241-1017 1017L7 590l242-241 775 775 775-775z"></path></svg>
                                                                </div>
                                                                <ul tabIndex={-1} class="menu menu-sm dropdown-content z-1 w-48 p-2 shadow" data-theme="black">
                                                                        {item.items.map((subItem) => (
                                                                                <li>
                                                                                        <a class="hover:text-accent uppercase" href={subItem.href}>
                                                                                                {subItem.name}
                                                                                        </a>
                                                                                </li>
                                                                        ))}
                                                                </ul>
                                                        </div>
                                                </li>
                                        );
                                } else {
                                        return (<li><a class="hover:text-accent uppercase" href={item.href}>{item.name}</a></li>);
                                }
                        })}
                </ul>
        </div>
        
        <div class="navbar-end max-md:shrink-0 max-md:w-auto">
                <Socials class="hidden lg:flex" />
                
                {/* MENU MOBILE */}
                <div class="dropdown dropdown-end">
                        <div tabIndex={0} role="button" class="hover:text-primary lg:hidden" aria-label="Menu">
                                <svg xmlns="http://w3.org" aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /> </svg>
                        </div>
                        <nav role="navigation" tabIndex={-1} class="menu menu-md dropdown-content z-1 mt-3 w-64 p-3 shadow lg:hidden" data-theme="light">
                                <ul>
                                {menuItems.map((item) => {
                                        if (item.items) {
                                                return (
                                                        <li>
                                                                <a class="uppercase" href={item.href}>{item.name}</a>
                                                                <ul class="p-2 border-l border-base-300 ml-2">
                                                                        {item.items.map((subItem) => {
                                                                                // Comparaison stricte avec le chemin nettoyé
                                                                                const isCurrentBandPage = currentPath === subItem.href;
                                                                                
                                                                                return (
                                                                                        <li>
                                                                                                <a href={subItem.href} class:list={['uppercase', { 'font-bold text-accent' : isCurrentBandPage }]}>
                                                                                                        {subItem.name}
                                                                                                </a>
                                                                                                {isCurrentBandPage && subItem.items && (
                                                                                                        <ul class="p-1 pl-3 opacity-80 border-l border-base-200 ml-2 space-y-1">
                                                                                                                {subItem.items.map((subSubItem) => (
                                                                                                                        <li>
                                                                                                                                {/* Construction de l'URL propre : /groupes/nom-du-groupe/#ancre */}
                                                                                                                                <a href={`${subItem.href}${subSubItem.href}`} class="uppercase text-xs hover:text-accent">
                                                                                                                                        {subSubItem.name}
                                                                                                                                </a>
                                                                                                                        </li>
                                                                                                                ))}
                                                                                                        </ul>
                                                                                                )}
                                                                                        </li>
                                                                                );
                                                                        })}
                                                                </ul>
                                                        </li>
                                                );
                                        } else {
                                                return (
                                                        <li><a class="uppercase" href={item.href}>{item.name}</a></li>
                                                );
                                        }
                                })}
                                </ul>
                                <div class="divider m-0"></div>
                                <Socials />
                        </nav>
                </div>
         </div>
</header>

<script>
  const initNavbarObserver = () => {
    const navbar = document.getElementById('navbar');
    const sentinel = document.getElementById('navbar-sentinel');

    if (!navbar || !sentinel) return;

    const observer = new IntersectionObserver(([entry]) => {
      // If the sentinel is NOT intersecting, the page has scrolled past its original position
      if (!entry.isIntersecting) {
        navbar.classList.add('shadow-sm');
      } else {
        navbar.classList.remove('shadow-sm');
      }
    }, {
      root: null,      // Tracks viewport intersections
      threshold: 0     // Fires as soon as 1px of the sentinel goes off-screen
    });

    observer.observe(sentinel);
  };

  // Safe execution with Astro's View Transitions (if you use them)
  initNavbarObserver();
  document.addEventListener('astro:after-swap', initNavbarObserver);
</script>
