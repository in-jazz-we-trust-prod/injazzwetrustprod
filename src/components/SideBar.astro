---
interface Props {
  class?: string;
  hasItems?: boolean;
}

const { class: className, hasItems = true } = Astro.props;
---

{/* La Sidebar ne s'affiche que si l'indicateur hasItems est vrai */}
{hasItems && (
  <aside 
    data-theme="dark" 
    data-sidebar-aside
    class:list={[
      "flex flex-col w-64 fixed top-[65px] h-[calc(100dvh-65px)] p-4 bg-base-100 overflow-hidden transition-[padding] duration-75 z-10", 
      className
    ]} 
    style="padding-bottom: calc(1rem + var(--footer-push, 0px));"
  >
    {Astro.slots.has('top') && (
      <div class="w-full h-[112px] shrink-0 border-b border-base-content/30">
        <slot name="top" />
      </div>
    )}

    <div class="overflow-y-auto min-h-0 w-full pt-2 mb-4 pr-1">
      <slot /> {/* Slot par défaut (principal) */}
    </div>

    {Astro.slots.has('bottom') && (
      <>
        <div class="flex-grow" />
        <div class="divider m-0 shrink-0" />
        <div class="w-full shrink-0 pt-3">
          <slot name="bottom" />
        </div>
      </>
    )}
  </aside>
)}

<script>
  function initSidebarShrink() {
    const sidebar = document.querySelector('[data-sidebar-aside]') as HTMLElement;
    const footer = document.querySelector('footer'); 
    
    if (!sidebar || !footer) return;

    function updateHeight() {
      const footerRect = footer.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      if (footerRect.top < windowHeight) {
        const overlap = windowHeight - footerRect.top;
        sidebar.style.setProperty('--footer-push', `${overlap}px`);
      } else {
        sidebar.style.setProperty('--footer-push', '0px');
      }
    }

    window.addEventListener('scroll', updateHeight, { passive: true });
    window.addEventListener('resize', updateHeight);
    
    updateHeight();
  }

  // Lancement à l'initialisation et après transition de page
  initSidebarShrink();
  document.addEventListener('astro:after-swap', initSidebarShrink);
</script>

