---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import { Icon } from 'astro-icon/components';

interface Props {
	imageFolder: string;
	prefix: string;
}

const { imageFolder, prefix } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/*/*.{jpeg,jpg,png,gif,webp,avif,svg}");
const imagePaths = Object.keys(images).filter((imagePath) => {
	return imagePath.startsWith(`/src/assets/${imageFolder}/`);
}).map((imagePath) => {
	return {
		path: imagePath,
		alt: imagePath.replace(`/src/assets/${imageFolder}/`, '').replace(/\..*/, '').replaceAll('-', ' ').replace(prefix, `${prefix} @`).replace(/(.*20.. )(.*)( copyright .*)/, '$1($2)$3').replace('copyright', '©'),
	};
});
---

<div
	id="gallery"
	class="container w-full m-4 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-2 md:gap-4 lg:gap-8"
>
	{
		imagePaths.map(async (imagePath) => {
			const image = images[imagePath.path]();
			const optimizedImage = await getImage({
				src: image,
				widths: [450, 674, 1350],
				format: 'webp',
			});

			return (
				<a
					href={optimizedImage.src}
					data-pswp-width={optimizedImage.attributes.width}
					data-pswp-height={optimizedImage.attributes.height}
					data-pswp-srcset={optimizedImage.srcSet.attribute}
					target="_blank"
					role="button"
					class="overflow-hidden border-primary hover:border-[3px] relative group"
				>
					<Image
						src={image}
						alt={imagePath.alt}
						class={
							"object-cover w-full transition duration-300 ease-in-out aspect-square"
						}
					/>
					<Icon class="absolute w-20 h-20 top-1/2 left-1/2 -mt-10 -ml-10 hidden group-hover:block text-primary" name="fa7-solid:maximize" title="Agrandir la photo" />
				</a>
			);
		})
	}
</div>

<style is:global>
.pswp__custom-caption {
  background: rgba(0, 0, 0, 0.75);
  font-size: 16px;
  color: #eeeeee;
  width: 100%;
  padding: 8px 16px;
  position: absolute;
  left: 50%;
  bottom: 32px;
  transform: translateX(-50%);
}
</style>

<script>
	import PhotoSwipeLightbox from "photoswipe/lightbox";
	import "photoswipe/style.css";

	const lightbox = new PhotoSwipeLightbox({
		gallery: "#gallery",
		children: "a",
		pswpModule: () => import("photoswipe"),
		zoom: false,
		imageClickAction: 'next',
  		tapAction: 'next',
	});

	lightbox.on('uiRegister', function() {
 		lightbox.pswp.ui.registerElement({
			name: 'custom-caption',
		    	order: 9,
		    	isButton: false,
		    	appendTo: 'root',
		    	html: 'Caption text',
		    	onInit: (el, pswp) => {
		      		lightbox.pswp.on('change', () => {
					const currSlideElement = lightbox.pswp.currSlide.data.element;
					let captionHTML = '';
					if (currSlideElement) {
					    captionHTML = currSlideElement.querySelector('img').getAttribute('alt');
					}
					el.innerHTML = captionHTML || '';
				});
		    	}
		  });
	});
	lightbox.init();
</script>
