---
const { 
	id,
	idle = false,
	date = 'upcoming',
	band,
	tickets = false,
	byYear = false,
	title = 'Bandsintown Viewer', 
	class: className, 
} = Astro.props;


const fallbackText = date === 'upcoming' ? 'Aucun concert prévu prochainement' : 'Aucun concert passé';

---
<bandsintown-viewer 
	id={id}
	idle={idle ? '' : undefined}
	class:list={["w-full", className]}
	date={date}
	band={band}
	tickets={tickets ? '' : undefined}
	by-year={byYear ? '' : undefined}
	fallback-text={fallbackText}
>
	<div class="flex flex-col justify-center items-center m-12"><div class="mb-8">Chargement des concerts en cours</div><div class="loading loading-dots loading-xl"></div></div>
</bandsintown-viewer>

<script>
	const artistsAndAppIds = {
		'2ble-barrel': { 
			name: "2ble Barrel",
			link: "/artistes/2ble-barrel/",
			artistId: "id_15628409", 
			appId: "b693f73cad3877e5d4d7a5542117afa7",
		}, 
		gus: {
			name: "GuS !",
			link: "/artistes/gus/",
			artistId: "id_15628410",
			appId: "ccd70a2b8f0cadbf61be0d6e1559df0b",
		},
		'the-dillingers': {
			name: "The Dillingers",
			link: "/artistes/the-dillingers/",
			artistId: "id_15628432",
			appId: "04aa449760082e70bc18eb1e6d1eae9d",
		},
		cetaces: {
			name: "Cetaces",
			link: "/artistes/cetaces/",
			artistId: "id_15648884",
			appId: "60cd548be8d0ed105cec488911d03f33",
		},
	};
	class BandsintownViewer extends HTMLElement {
		get idle() {
			return this.hasAttribute('idle');
		}
		get date() {
			return this.getAttribute('date');
		}
		get band() {
			const band = this.getAttribute('band');
			return band && artistsAndAppIds[band];
		}
		get bands() {
			return this.band && [this.band] || Object.values(artistsAndAppIds);
		}
		get tickets() {
			return this.hasAttribute('tickets');
		}
		get byYear() {
			return this.hasAttribute('by-year');
		}
		get fallbackText() {
			return this.getAttribute('fallback-text');
		}

		async fetchArtistEvents(artistId, appId, date) {
			const response = await fetch(`https://rest.bandsintown.com/artists/${artistId}/events?app_id=${appId}&date=${date}`);
			return response.json();
		}
		
		async displayConcerts() {
			const allEvents = [];
			const allEventsByYear = {};
			const artistNames = {};
			for (const { name, link, artistId, appId } of this.bands) {
				const events = await this.fetchArtistEvents(artistId, appId, this.date);
				for (let event of events) {
					if (event.artist) {
						artistNames[name] = event.artist.name;
					}
					const date = new Date(event.datetime);
					if (this.byYear) {
						const year = date.getFullYear();
						if (!allEventsByYear[year]) {
							allEventsByYear[year] = [];
						}
						allEventsByYear[year].push({ myDate: date, myName: name, myLink: link, artistName: artistNames[name], ...event });
					} else {
						allEvents.push({ myDate: date,  myName: name, myLink: link, artistName: artistNames[name], ...event });
					}
				}
			}
			
			if (!allEvents.length && !Object.keys(allEventsByYear).length) {
				const fallback = document.createElement('div');
				fallback.classList.add('w-full', 'text-center', 'p-4');
				fallback.append(this.fallbackText);
				this.replaceChildren(fallback);
				return;
			}

			const eventList = document.createElement('ul');

			if (this.byYear) {
				Object.keys(allEventsByYear).forEach((key) => {
					allEventsByYear[key] = allEventsByYear[key].sort((a, b) => a.myDate - b.myDate);
				});

				Object.keys(allEventsByYear).sort((a, b) => b - a).forEach((key) => {
					const yearLine = document.createElement('li');
					yearLine.classList.add('pt-2');
					const yearDiv = document.createElement('div');
					yearDiv.classList.add('text-3xl', 'text-center', 'font-serif');
					yearDiv.append(key);
					const yearEvents = document.createElement('ul');
					yearEvents.classList.add('bg-base-100', 'rounded-box', 'shadow-md');
					yearLine.append(yearDiv,yearEvents);
					eventList.append(yearLine);
					allEventsByYear[key].forEach((event) => this.createEvent(yearEvents, event));
				});
			} else {
				eventList.classList.add('bg-base-100', 'rounded-box', 'shadow-md'); /*"grid-cols-12 bg-base-100 rounded-box shadow-md"*/
				allEvents.sort((a, b) => a.myDate - b.myDate);
				allEvents.forEach((event) => this.createEvent(eventList, event)); 
			}

			this.replaceChildren(eventList);
		}

		createEvent(eventList, event) {
			if (event.myDate < Date.now()) {
				event.inThePast = true;
			}
			event.formattedDate = `${event.myDate.toLocaleDateString('fr-FR', { weekday: 'short', month: 'short', year: 'numeric', day: 'numeric' })} @ ${event.myDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit'})}`;
			if (event.venue.country !== 'France') {
				event.formattedLocation = `${event.venue.city}, ${event.venue.country}`;
			} else if (event.venue.postal_code) {
				event.formattedLocation = `${event.venue.city} (${event.venue.postal_code.substring(0, 2)})`;
			} else {
				event.formattedLocation = event.venue.city;
			}
			if (event.lineup && event.lineup.length > 1) {
				// search other bands in lineup
				const otherBands = [];
				for (let band of event.lineup) {
					if (band !== event.artistName) {
						otherBands.push(band);
					}
				}
				event.formattedLineup = otherBands.join(' & ');
			}
			if (event.offers.length > 0) {
				for (let offer of event.offers) {
					if (offer.type === 'Tickets') {
						event.myTickets = offer;
						break;
					}
				}
			}
			
			const eventLine = document.createElement('li');
			eventLine.classList.add('flex', 'flex-col', 'lg:flex-row', 'justify-items-stretch', 'py-4', 'border-b', 'last:border-0', 'border-base-300');
			
			const eventDetails = document.createElement('div');
			eventDetails.classList.add('flex', 'flex-col', 'flex-wrap', 'lg:flex-row', 'justify-items-stretch', 'w-full');
			
			const dateDiv = document.createElement('div');
			dateDiv.classList.add('w-full', 'lg:w-1/3', 'text-center', 'lg:text-left');
			dateDiv.textContent = event.formattedDate;

			const venueDiv = document.createElement('div');
			venueDiv.classList.add('w-full', 'lg:w-1/3', 'text-center', 'lg:text-left');
			
			const venueName = document.createElement('span');
			venueName.textContent = event.venue.name
			venueDiv.appendChild(venueName);

			if (event.title) {
				const eventTitle = document.createElement('p');
				eventTitle.classList.add('text-xs', 'opacity-60', 'italic', 'mt-0.5');
				eventTitle.textContent = event.title;
				venueDiv.appendChild(eventTitle);			
			}

			const locationDiv = document.createElement('div');
			locationDiv.classList.add('w-full', 'lg:w-1/3', 'text-center', this.date === 'upcoming' && this.tickets ? 'lg:text-left' : 'lg:text-right');
			locationDiv.textContent = event.formattedLocation;

			if (this.band) {
				eventDetails.append(dateDiv, venueDiv, locationDiv);
				if (event.formattedLineup) {
					const bandLineup = document.createElement('span');
					bandLineup.classList.add('text-center', 'lg:text-left', 'font-serif');
					bandLineup.textContent = ` (avec ${event.formattedLineup})`;
					eventDetails.append(bandLineup);
				}
			} else {
				const bandDiv = document.createElement('span');
				bandDiv.classList.add('w-full', 'text-center', 'lg:text-left', 'text-lg', 'font-serif');
				const bandLink = document.createElement('a');
				bandLink.classList.add('hover:text-primary');
				bandLink.href = event.myLink;
				bandLink.textContent = event.myName;
				bandDiv.append(bandLink);
				if (event.formattedLineup) {
					const bandLineup = document.createElement('span');
					bandLineup.classList.add('font-serif');
					bandLineup.textContent = ` (avec ${event.formattedLineup})`;
					bandDiv.append(bandLineup);
				}
				eventDetails.append(bandDiv, dateDiv, venueDiv, locationDiv);
			}

			eventLine.append(eventDetails);

			if (this.date === 'upcoming' && this.tickets) {
				eventDetails.classList.add('sm:w-2/3', 'lg:w-5/6');
				const ticketsDiv = document.createElement('div');
				ticketsDiv.classList.add('w-full', 'sm:w-1/3', 'lg:1/6', 'text-center');
				if (!event.inThePast) {
					if (event.free) {
						ticketsDiv.append('GRATUIT');
					} else if (!event.myTickets) {
						ticketsDiv.append('SUR PLACE');
					} else {
						const ticketLink = document.createElement('a');
						icketLink.setAttribute('role', 'button');
                                                ticketLink.classList.add('btn', 'btn-sm', 'btn-primary');
                                                ticketLink.setAttribute('href', event.myTickets.url);
                                                ticketLink.setAttribute('rel', 'noopener');
                                                ticketLink.setAttribute('target', '_blank');
                                                ticketLink.textContent = 'Réserver';
                                                ticketsDiv.appendChild(ticketLink);
					}
				}
				eventLine.append(ticketsDiv);
			}
			
			eventList.appendChild(eventLine);
		}

		static get observedAttributes() {
   			 return ['idle'];
  		}
		
		connectedCallback() {
			if (!this.idle) {
				this.displayConcerts(); 
			}
		}
		attributeChangedCallback(name, oldValue, newValue) {
			if (name === 'idle' && newValue == null ) {
  				this.displayConcerts();
			}
		}
	}

	customElements.define('bandsintown-viewer', BandsintownViewer);
</script>
